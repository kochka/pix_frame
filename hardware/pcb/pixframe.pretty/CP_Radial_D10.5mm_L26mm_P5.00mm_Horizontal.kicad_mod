(footprint "CP_Radial_D10.5mm_L26mm_P5.00mm_Horizontal" (version 20260206) (generator "pcbnew") (layer "F.Cu")
      (descr "Horizontal radial electrolytic; 5 mm lead pitch, maximum sleeve diameter 10.5 mm, case length 26 mm. Body starts 3 mm from pads. Keep 2 mm clear beyond the pressure vent. Panasonic EEUFR1E102L or matching geometry; verify forming and hold-down.")
      (tags "radial electrolytic horizontal low profile") (attr through_hole)
      (property "Reference" "C**" (at 2.5 -2.8 0) (layer "F.SilkS") (effects (font (size 1 1))))
      (property "Value" "1000u/25V" (at 2.5 33 0) (layer "F.Fab") (effects (font (size 1 1))))
      (property "Datasheet" "https://industrial.panasonic.com/cdbs/www-data/pdf/RDF0000/ABA0000C1259.pdf" (at 0 0 0) (layer "F.Fab") (hide yes) (effects (font (size 1 1))))
      (fp_rect (start -2.75 3) (end 7.75 29) (stroke (width .1) (type solid)) (fill none) (layer "F.Fab"))
      (fp_rect (start -2.9 2.9) (end 7.9 29.1) (stroke (width .12) (type solid)) (fill none) (layer "F.SilkS"))
      (fp_rect (start -3.2 -1.5) (end 8.2 31.5) (stroke (width .05) (type solid)) (fill none) (layer "F.CrtYd"))
      (fp_text user "+" (at -2 0 0) (layer "F.SilkS") (effects (font (size 1 1))))
      (fp_text user "VENT KEEP FREE" (at 2.5 30.4 0) (layer "F.Fab") (effects (font (size .8 .8))))
      (pad "1" thru_hole rect (at 0 0) (size 2 2) (drill .8) (layers "*.Cu" "*.Mask"))
      (pad "2" thru_hole circle (at 5 0) (size 2 2) (drill .8) (layers "*.Cu" "*.Mask"))
      (model "${KIPRJMOD}/pixframe.3dshapes/C2_horizontal_envelope.wrl"
    (offset (xyz 0 0 0)) (scale (xyz 1 1 1)) (rotate (xyz 0 0 0)))
)
