# Cargo build output
/target/
**/target/

# Assets
/assets/

# Device configuration (contains the Wi-Fi password)
/config.toml

# Local Mise configuration
.mise.local.toml

# Editor configuration
.vscode/
.zed/
.helix/
.nvim.lua
.idea/

# rustfmt backup files
**/*.rs.bk

# Platform-specific files
*.pdb
**/.DS_Store

# KiCad local state and backups
**/*.kicad_prl
**/*-backups/
**/fp-info-cache
**/~*.lck
__pycache__/
**/.history

# KiCad automatic saves and legacy/library backups
/hardware/pcb/*.bak
/hardware/pcb/*.kicad_sch~
/hardware/pcb/*.kicad_pcb~
/hardware/pcb/_autosave-*

# Generated fabrication packages and local Fabrication Toolkit preferences
/hardware/pcb/production/
/hardware/pcb/fabrication-toolkit-options.json

# Generated KiCad validation reports
/hardware/pcb/*.drc.json
/hardware/pcb/*.erc.json
/hardware/pcb/*.rpt
